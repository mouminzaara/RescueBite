# ============================================================
# RescueBite — AWS Configuration
# ============================================================
# Copy this file to .env and fill in your AWS details.
# NEVER commit the .env file to version control.
# ============================================================

# AWS Region (e.g. ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# DynamoDB Table Names
DYNAMODB_RESTAURANTS_TABLE=RescueBite-Restaurants
DYNAMODB_FOOD_LISTINGS_TABLE=RescueBite-FoodListings
DYNAMODB_RESERVATIONS_TABLE=RescueBite-Reservations

# Lambda Function Name
LAMBDA_PRIORITY_FUNCTION=RescueBite-PriorityProcessor

# AWS Credentials (for local development only)
# Preferred: configure via `aws configure` or IAM role.
# Only set these if you cannot use the default credential chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
